Package: ausparl
Title: Query the Australian Parliamentary Hansard Database
Version: 0.1.0
Authors@R: c(
    person("Pat", "Leslie", email = "patrick.leslie@anu.edu.au", role = c("aut", "cre"),
           comment = c(ORCID = "0000-0002-9218-8981")),
